/* ---------- Moduswahl (Erstellen / Ãœben / Spielen) ---------- */
.fc-mode-switch{
  display:flex;
  gap:8px;
  background:var(--bg-soft, #f4f1e8);
  border-radius:14px;
  padding:5px;
  margin-bottom:18px;
  max-width:520px;
}
.fc-mode-btn-item{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  border:none;
  background:transparent;
  padding:10px 12px;
  border-radius:10px;
  font-family:'Karla', sans-serif;
  font-weight:700;
  font-size:12.5px;
  color:var(--ink-soft, #5c5a52);
  cursor:pointer;
  transition:background .15s ease, color .15s ease, box-shadow .15s ease;
}
.fc-mode-btn-item:hover{ color:var(--ink, #2b2b26); }
.fc-mode-btn-item.active{
  background:var(--surface, #fff);
  color:var(--sage, #7c9473);
  box-shadow:0 2px 6px rgba(0,0,0,.08);
}
.fc-mode-ico{ width:16px; height:16px; flex-shrink:0; }

/* ---------- Karte anlegen ---------- */
.fc-create-form{
  display:grid;
  grid-template-columns:1fr 1fr auto auto;
  gap:10px;
  align-items:center;
  margin-bottom:6px;
}
.fc-create-form input,
.fc-create-form select{
  border:1px solid var(--line, #e3ded2);
  background:var(--bg-soft, #f4f1e8);
  border-radius:10px;
  padding:11px 13px;
  font-family:'Karla', sans-serif;
  font-size:13.5px;
  color:var(--ink, #2b2b26);
  transition:border-color .15s ease, box-shadow .15s ease, background .15s ease;
}
.fc-create-form input:focus,
.fc-create-form select:focus{
  outline:none;
  border-color:var(--sage, #7c9473);
  background:var(--surface, #fff);
  box-shadow:0 0 0 3px color-mix(in srgb, var(--sage, #7c9473) 18%, transparent);
}
.fc-create-hint{
  font-size:11px;
  color:var(--ink-faint, #9a9689);
  margin-bottom:16px;
}
@media (max-width: 760px){
  .fc-create-form{ grid-template-columns:1fr; }
}

.fc-manage-count{
  text-align:center;
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.05em;
  color:var(--ink-faint, #9a9689);
  margin:14px 0 10px;
}

/* ---------- Kartenliste (Verwalten) ---------- */
.fc-manage-list{
  display:flex;
  flex-direction:column;
  gap:8px;
}
.fc-row{
  display:grid;
  grid-template-columns:1fr auto 1fr auto auto;
  gap:8px;
  align-items:center;
  background:var(--bg-soft, #f4f1e8);
  border:1px solid transparent;
  border-radius:12px;
  padding:9px 10px;
  transition:border-color .15s ease, background .15s ease;
}
.fc-row:hover{
  border-color:var(--line, #e3ded2);
  background:var(--surface, #fff);
}
.fc-row input{
  border:1px solid transparent;
  background:var(--surface, #fff);
  border-radius:8px;
  padding:8px 10px;
  font-family:'Karla', sans-serif;
  font-size:13px;
  color:var(--ink, #2b2b26);
  min-width:0;
}
.fc-row:hover input{ background:var(--bg-soft, #f4f1e8); }
.fc-row input:focus{
  outline:none;
  border-color:var(--sage, #7c9473);
  background:var(--surface, #fff);
}
.fc-row select{
  border:1px solid var(--line, #e3ded2);
  background:var(--surface, #fff);
  border-radius:8px;
  padding:7px 8px;
  font-size:12px;
  color:var(--ink-soft, #5c5a52);
}
.fc-row .icon-btn.divider{
  width:28px; height:28px;
  display:flex; align-items:center; justify-content:center;
  border-radius:50%;
  color:var(--ink-faint, #9a9689);
  font-size:14px;
  transition:background .15s ease, color .15s ease, transform .2s ease;
}
.fc-row .icon-btn.divider:hover{
  background:color-mix(in srgb, var(--sage, #7c9473) 15%, transparent);
  color:var(--sage, #7c9473);
  transform:rotate(180deg);
}
.fc-row > .icon-btn:last-child{
  width:24px; height:24px;
  display:flex; align-items:center; justify-content:center;
  border-radius:50%;
  color:var(--ink-faint, #9a9689);
  font-size:11px;
}
.fc-row > .icon-btn:last-child:hover{
  background:color-mix(in srgb, var(--cal-klausur, #c1615a) 15%, transparent);
  color:var(--cal-klausur, #c1615a);
}

/* ---------- Ãœbungsmodus: Fortschritt ---------- */
.study-wrap{
  max-width:520px;
  margin:0 auto;
  display:flex;
  flex-direction:column;
  align-items:center;
}
.study-counter{
  display:flex;
  align-items:center;
  gap:16px;
  font-family:'Karla', sans-serif;
  font-size:12.5px;
  font-weight:700;
  margin-bottom:10px;
  width:100%;
  justify-content:center;
}
.study-counter .correct{ color:var(--sage, #7c9473); }
.study-counter .wrong{ color:var(--cal-klausur, #c1615a); }
.study-counter .study-progress{
  color:var(--ink-faint, #9a9689);
  font-weight:600;
  font-family:'IBM Plex Mono', monospace;
}
.study-progress-track{
  width:100%;
  height:5px;
  background:var(--bg-soft, #f4f1e8);
  border-radius:999px;
  overflow:hidden;
  margin-bottom:22px;
}
.study-progress-fill{
  height:100%;
  background:var(--sage, #7c9473);
  border-radius:999px;
  transition:width .25s ease;
}

/* ---------- Flip-Karte ---------- */
.flip-card{
  width:100%;
  max-width:460px;
  aspect-ratio:16 / 10;
  perspective:1400px;
  cursor:pointer;
  margin-bottom:22px;
}
.flip-inner{
  position:relative;
  width:100%; height:100%;
  transition:transform .5s cubic-bezier(.4,.2,.2,1);
  transform-style:preserve-3d;
}
.flip-card.flipped .flip-inner{ transform:rotateY(180deg); }
.flip-face{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  backface-visibility:hidden;
  border-radius:22px;
  padding:32px;
  font-family:'Fraunces', serif;
  font-weight:600;
  font-size:24px;
  line-height:1.3;
  color:var(--ink, #2b2b26);
  box-shadow:0 6px 20px rgba(0,0,0,.08);
  border:1px solid var(--line, #e3ded2);
}
.flip-front{ background:var(--surface, #fff); }
.flip-back{
  background:color-mix(in srgb, var(--sage, #7c9473) 10%, var(--surface, #fff));
  transform:rotateY(180deg);
}
.flip-hint{
  position:absolute;
  bottom:14px;
  left:0; right:0;
  text-align:center;
  font-family:'Karla', sans-serif;
  font-weight:600;
  font-size:10.5px;
  letter-spacing:.03em;
  text-transform:uppercase;
  color:var(--ink-faint, #9a9689);
}

.study-rate-row{
  display:flex;
  align-items:center;
  gap:14px;
  margin-bottom:10px;
}
.study-key-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:4px;
}
.study-key-hint{
  font-family:'IBM Plex Mono', monospace;
  font-size:10px;
  color:var(--ink-faint, #9a9689);
}
.btn.correct-btn{
  background:var(--sage, #7c9473);
  color:#fff;
  border:none;
}
.btn.correct-btn:hover{ filter:brightness(1.08); }
.btn.wrong-btn{
  background:var(--cal-klausur, #c1615a);
  color:#fff;
  border:none;
}
.btn.wrong-btn:hover{ filter:brightness(1.08); }
.study-kbd-hint{
  font-size:11px;
  color:var(--ink-faint, #9a9689);
  display:flex;
  align-items:center;
  gap:6px;
}
.study-kbd-hint kbd{
  font-family:'IBM Plex Mono', monospace;
  font-size:10px;
  background:var(--bg-soft, #f4f1e8);
  border:1px solid var(--line, #e3ded2);
  border-radius:5px;
  padding:2px 6px;
}

/* ---------- Abschluss (Ãœben) ---------- */
.study-finish, .game-over{
  text-align:center;
  padding:30px 10px;
}
.study-finish .big-num, .game-over .big-num{
  font-family:'Fraunces', serif;
  font-weight:700;
  font-size:52px;
  color:var(--sage, #7c9473);
}
.study-finish .big-num .of{
  font-size:26px;
  color:var(--ink-faint, #9a9689);
  font-weight:500;
}
.study-finish p, .game-over p{
  color:var(--ink-soft, #5c5a52);
  font-size:13.5px;
  margin:6px 0 20px;
}
.study-finish-actions{
  display:flex;
  gap:10px;
  justify-content:center;
  flex-wrap:wrap;
}
.game-high{
  font-family:'Karla', sans-serif;
  font-weight:700;
  font-size:13px;
  color:var(--ink-faint, #9a9689);
  margin-bottom:20px;
}
.game-high.new{ color:var(--sage, #7c9473); }

/* ---------- Spielemodus ---------- */
.game-topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  width:100%;
  margin-bottom:10px;
  font-family:'Karla', sans-serif;
  font-weight:700;
  font-size:12.5px;
}
.game-lives{ display:flex; gap:3px; }
.heart{
  color:var(--cal-klausur, #c1615a);
  font-size:16px;
  transition:opacity .2s ease, transform .2s ease;
}
.heart.lost{ opacity:.18; transform:scale(.85); }
.game-score{ color:var(--ink, #2b2b26); }
.game-streak{ color:var(--sage, #7c9473); }

.game-timerbar-track{
  width:100%;
  height:5px;
  background:var(--bg-soft, #f4f1e8);
  border-radius:999px;
  overflow:hidden;
  margin-bottom:20px;
}
.game-timerbar-fill{
  height:100%;
  background:var(--sage, #7c9473);
  border-radius:999px;
  transition:width 1s linear;
}
.game-timerbar-fill.warn{ background:var(--cal-klausur, #c1615a); }

.game-question-card{
  width:100%;
  background:color-mix(in srgb, var(--sage, #7c9473) 8%, var(--surface, #fff));
  border:1px solid var(--line, #e3ded2);
  border-radius:20px;
  padding:34px 24px;
  text-align:center;
  font-family:'Fraunces', serif;
  font-weight:600;
  font-size:23px;
  color:var(--ink, #2b2b26);
  margin-bottom:18px;
}
.game-options-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  width:100%;
}
@media (max-width: 520px){
  .game-options-grid{ grid-template-columns:1fr; }
}
.game-option-btn{
  display:flex;
  align-items:center;
  gap:10px;
  text-align:left;
  border:1px solid var(--line, #e3ded2);
  background:var(--surface, #fff);
  border-radius:12px;
  padding:13px 14px;
  font-family:'Karla', sans-serif;
  font-size:13.5px;
  font-weight:600;
  color:var(--ink, #2b2b26);
  cursor:pointer;
  transition:border-color .15s ease, background .15s ease, transform .1s ease;
}
.game-option-btn:hover:not(:disabled){
  border-color:var(--sage, #7c9473);
  background:color-mix(in srgb, var(--sage, #7c9473) 6%, var(--surface, #fff));
}
.game-option-btn:active:not(:disabled){ transform:scale(.98); }
.game-option-btn:disabled{ cursor:default; }
.game-option-num{
  flex-shrink:0;
  width:20px; height:20px;
  border-radius:50%;
  background:var(--bg-soft, #f4f1e8);
  color:var(--ink-faint, #9a9689);
  font-size:10.5px;
  font-weight:700;
  display:flex;
  align-items:center;
  justify-content:center;
}
.game-option-btn.correct{
  border-color:var(--sage, #7c9473);
  background:color-mix(in srgb, var(--sage, #7c9473) 14%, var(--surface, #fff));
}
.game-option-btn.correct .game-option-num{
  background:var(--sage, #7c9473);
  color:#fff;
}
.game-option-btn.wrong{
  border-color:var(--cal-klausur, #c1615a);
  background:color-mix(in srgb, var(--cal-klausur, #c1615a) 12%, var(--surface, #fff));
}
.game-option-btn.wrong .game-option-num{
  background:var(--cal-klausur, #c1615a);
  color:#fff;
}